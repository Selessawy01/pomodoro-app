@use "../abstract/variables" as v;
@use "../abstract/breakpoints" as b;

// ========================================
// HEADER
// ========================================
.header__logo {
    height           : clamp(1.875rem, 5.3vw, 2.5rem);
}

.header__tabs {
    background-color  : v.$tabs-bg-clr;
    border-radius     : 1.97rem;
    width             : 100%;
    height            : 3.9375rem;

    display           : flex;
    align-items       : center;
    justify-content   : center;
    color             : v.$primary-txt-clr;
}

// ========================================
// TIMER
// ========================================

.timer {
   // padding-block-start : clamp( v.$spacing-600,10.5vw,v.$spacing-1000);
    padding-block       : v.$spacing-600;
   // padding-block-end   : v.$spacing-600;
    margin-inline       : auto;

    display             : flex;
    flex-direction      : column;
    align-items         : center;
    justify-content     : center;

    gap                 : v.$spacing-1000;
    width               : 18.75rem;

    @media(min-width:b.$bp-md)
    { 
    gap                 : 9rem;
    padding-block       : 6.75rem;
   // padding-block-end   : 103px;
    width               : 25.625rem;
    }

    @media(min-width:b.$bp-xl)
    {
    gap                 : v.$spacing-800;
    padding-block-start : v.$spacing-500;
    padding-block-end   : v.$spacing-700;
    }
}

// ========================================
// OUTER TIMER
// ========================================

.timer__display {
    width         : 300px;
    height        : 300px;
    box-sizing    : border-box;

    border        : 1rem solid transparent;
    border-radius : 50%;

    background    : linear-gradient( v.$color-blue-900, v.$color-blue-900) padding-box,
                    v.$gradient-border border-box;

    box-shadow    : -20px -20px 40px rgba(255, 255, 255, 0.1),
                     20px 20px 40px rgba(0, 0, 0, 0.4);

    position      : relative;

    display       : grid;
    place-items   : center;

    @media(min-width:b.$bp-md)
    {
    width         : 410px;
    height        : 410px;
    border        : 1.375rem solid transparent;

    }
}

// ========================================
// SVG
// ========================================

.timer__progress-ring {

    box-sizing    : border-box;
    position      : absolute;

    top           : 0;
    left          : 0;
   // width         : 100%;
   // height        : 100%;
    padding       : v.$spacing-125;

    display       : block;
    transform     : rotate(-90deg);
    overflow      : visible;

    @media(min-width:b.$bp-md)
    {
    padding       : v.$spacing-150; 
    }
}

// ========================================
// PROGRESS CIRCLES
// ========================================

.timer__progress-background,
.timer__progress-bar {
    fill          : none;
    stroke-width  : 0.5rem;

    @media(min-width:b.$bp-md)
    {
    stroke-width  :  0.6875rem;
    }
  //  width        : 100%;
  //  height       : 100%;
}

// Background track
.timer__progress-background {
    stroke           : v.$color-blue-900;
}

// Cyan progress
.timer__progress-bar {
    stroke           : v.$color-cyan;
    
    // Rounded ends
    stroke-linecap   : round;

    /*  Circle circumference:  2 × π × 115 ≈ 722.6 */
    stroke-dasharray : 722.6;

    /* 75% progress */
    stroke-dashoffset: 180.65;
}


// ========================================
// CENTER
// ========================================

.timer__time {
    position         : relative;
    z-index          : 1;
    
    //width            : 193px;
    //height           : 124px;

    border-radius    : 50%;
    background-color : v.$color-blue-900;

    display          : flex;
    flex-direction   : column;
    align-items      : center;
    justify-content  : center;
    color            : v.$primary-txt-clr;
   

    @media(min-width:b.$bp-md)
    {
   // width           : 260px;
    //height          : 158px;
    gap              : v.$spacing-100;
    }
}
// ========================================
// RESTART
// ========================================

.timer__status {
    color            : v.$primary-txt-clr ;
}

// ========================================
// Timer Settings
// ========================================

.timer__settings{
    width            : 1.6875rem;
    height           : 1.75rem;
}